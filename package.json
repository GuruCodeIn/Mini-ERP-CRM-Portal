{
  "name": "mini-erp-crm-portal",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @mini-erp/api --filter @mini-erp/web dev",
    "build": "pnpm --filter @mini-erp/api build && pnpm --filter @mini-erp/web build",
    "lint": "pnpm --filter @mini-erp/api lint && pnpm --filter @mini-erp/web lint",
    "db:generate": "pnpm --filter @mini-erp/api prisma:generate",
    "db:migrate": "pnpm --filter @mini-erp/api prisma:migrate",
    "db:seed": "pnpm --filter @mini-erp/api prisma:seed"
  }
}
